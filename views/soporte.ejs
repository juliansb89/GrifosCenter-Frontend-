<%- include('partials/header') %>

<div class="page-header" style="text-align: center; margin-bottom: 2rem;">
    <h1>Soporte Técnico</h1>
    <p>¿Necesitas ayuda con alguna instalación o repuesto? Estamos para servirte.</p>
</div>

<div class="container animate-fade-in-up delay-100" style="max-width: 600px; padding: 0;">
    <div class="card">
        <form action="/soporte" method="POST" onsubmit="event.preventDefault(); alert('Mensaje enviado al equipo de soporte. Te contactaremos pronto.'); window.location.href='/menu';">
            <div class="form-group">
                <label class="form-label">Motivo de contacto</label>
                <select class="form-control" required>
                    <option value="" disabled selected>Selecciona una opción</option>
                    <option value="instalacion">Ayuda con Instalación</option>
                    <option value="garantia">Reclamo de Garantía</option>
                    <option value="repuestos">Solicitud de Repuestos</option>
                    <option value="otros">Otros</option>
                </select>
            </div>
            
            <div class="form-group">
                <label class="form-label">ID de Factura (Opcional)</label>
                <input type="text" class="form-control" placeholder="Ej: 1001">
            </div>
            
            <div class="form-group">
                <label class="form-label">Mensaje</label>
                <textarea class="form-control" rows="5" placeholder="Describe el problema o tu consulta en detalle..." required></textarea>
            </div>
            
            <button type="submit" class="btn btn-primary" style="width: 100%;">Enviar Mensaje de Soporte</button>
        </form>
    </div>
</div>

<%- include('partials/footer') %>
