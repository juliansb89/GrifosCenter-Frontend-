<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Grifos Center</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="<%= (typeof role !== 'undefined' && role !== null && role !== 'Cliente') ? '' : 'no-sidebar' %>">
    <div class="app-container">
        
        <% if (typeof role !== 'undefined' && role !== null && role !== 'Cliente') { %>
        <!-- Sidebar for Admin/Employees -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <a href="/" class="sidebar-brand">
                    <span>💧</span> Grifos Center
                </a>
            </div>
            <nav class="sidebar-menu">
                <a href="/dashboard-admin" class="sidebar-item">
                    <span>📊</span> Dashboard
                </a>
                <a href="/productos" class="sidebar-item">
                    <span>🚿</span> Productos
                </a>
                <a href="/clientes-admin" class="sidebar-item">
                    <span>🤝</span> Clientes
                </a>
                <a href="/facturacion" class="sidebar-item">
                    <span>🧾</span> Facturación
                </a>
                <a href="/usuarios" class="sidebar-item">
                    <span>👥</span> Usuarios
                </a>
                <a href="/empleados" class="sidebar-item">
                    <span>👔</span> Personal
                </a>
                <a href="/menu" class="sidebar-item" style="margin-top: 1rem; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 1rem;">
                    <span>🏠</span> Menú Principal
                </a>
            </nav>
        </aside>
        <% } %>

        <div class="main-content">
            <!-- Topbar -->
            <header class="topbar">
                <% if (typeof role === 'undefined' || role === null || role === 'Cliente') { %>
                <div class="navbar-brand">
                    <a href="/" class="brand-logo">
                        <span style="font-size: 1.8rem;">💧</span>
                        <span class="text-gradient">Grifos Center</span>
                    </a>
                </div>
                <% } else { %>
                <div></div> <!-- Spacer for flexbox -->
                <% } %>
                
                <div class="topbar-right">
                    <a href="/catalogo" class="btn btn-outline btn-sm">Ver Catálogo</a>
                    
                    <% if (typeof role !== 'undefined' && role === 'Cliente') { %>
                        <a href="/menu" class="btn btn-outline btn-sm" style="margin-left: 0.5rem;">Mis Compras</a>
                    <% } %>
                    
                    <% if (typeof role === 'undefined' || role === null || role === 'Cliente') { %>
                        <a href="/mi-carrito" class="cart-icon-container" style="text-decoration: none; position: relative; font-size: 1.25rem; margin-right: 0.5rem; margin-left: 0.5rem;" title="Mi Carrito">
                            🛒
                            <span id="cart-badge" style="position: absolute; top: -5px; right: -10px; background: var(--danger); color: white; border-radius: 50%; padding: 0.1rem 0.3rem; font-size: 0.7rem; font-weight: bold; display: none;">0</span>
                        </a>
                    <% } %>

                    <% if (typeof role !== 'undefined' && role !== null) { %>
                        <div class="user-profile">
                            <div class="user-info text-right">
                                <span class="user-name"><%= name %></span>
                                <span class="user-role"><%= role %></span>
                            </div>
                            <div class="user-avatar">
                                <%= name.charAt(0).toUpperCase() %>
                            </div>
                        </div>
                        <a href="/logout" class="btn btn-outline btn-sm">Salir</a>
                    <% } else { %>
                        <a href="/login" class="btn btn-primary btn-sm">Iniciar Sesión</a>
                    <% } %>
                </div>
            </header>

            <!-- Page Content -->
            <main class="container animate-fade-in-up">
