<%- include('partials/header') %>

<div class="page-header flex items-center justify-between animate-fade-in-up" style="flex-wrap: wrap; gap: 1rem;">
    <div>
        <h1 class="page-title">Gestión de <%= modulo %></h1>
        <p class="page-description">Administración del módulo <%= modulo.toLowerCase() %></p>
    </div>
    <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
        <input type="text" id="searchInput" class="form-control" placeholder="🔍 Buscar <%= modulo.toLowerCase() %>..." onkeyup="filtrarLista()" style="min-width: 250px; border-radius: 20px; padding: 0.5rem 1rem;">
        <a href="/<%= modulo.toLowerCase() %>/crear" class="btn btn-primary" style="white-space: nowrap;">➕ Nuevo <%= modulo.slice(0, -1) %></a>
    </div>
</div>

<% 
    const categoriasMapa = {
        1: 'Grifería para Baños',
        2: 'Grifería para Cocina',
        3: 'Tinas y Spas',
        4: 'Accesorios',
        5: 'Eléctricos y Cocina'
    };
%>

<% if (modulo === 'productos' || modulo === 'empleados' || modulo === 'clientes-admin') { %>
    
    <% if (modulo === 'productos' && items && items.length > 0) { %>
        <% [1, 2, 3, 4, 5].forEach(catId => { %>
            <% const catItems = items.filter(p => p.Id_categoria == catId || p.id_categoria == catId); %>
            <% if (catItems.length > 0) { %>
                <h3 style="margin-top: 2rem; margin-bottom: 0.5rem; color: var(--primary-color); border-bottom: 2px solid var(--primary-color); padding-bottom: 0.5rem;"><%= categoriasMapa[catId] %></h3>
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem; padding: 1rem 0; margin-bottom: 1rem;">
                    <% catItems.forEach(item => { %>
                        <div class="product-admin-card searchable-item animate-fade-in-up" data-search="<%= (item.nombre || item.nombre_completo || '').toLowerCase() %> <%= (item.descripcion || '').toLowerCase() %>" style="padding: 1.2rem; border-radius: 12px; border: 1px solid var(--border-color); background: white; box-shadow: 0 2px 8px rgba(0,0,0,0.04); transition: transform 0.2s; display: flex; flex-direction: column;">
                            <div style="display: flex; gap: 1rem; margin-bottom: 1rem;">
                                <!-- Miniatura -->
                                <div style="width: 70px; height: 70px; border-radius: 50%; overflow: hidden; background-color: #f8f9fa; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border: 1px solid #eee;">
                                    <% if (item.imagen_url && item.imagen_url.trim() !== '') { %>
                                        <img src="<%= item.imagen_url %>" alt="<%= item.nombre %>" style="width: 100%; height: 100%; object-fit: cover;">
                                    <% } else { %>
                                        <span style="font-size: 2rem; color: #dee2e6;">📸</span>
                                    <% } %>
                                </div>
                                
                                <!-- Datos Principales -->
                                <div style="flex-grow: 1; overflow: hidden;">
                                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.25rem;">
                                        <h3 style="margin: 0; font-size: 1.1rem; font-weight: 600; color: var(--text-color); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= item.nombre %>"><%= item.nombre %></h3>
                                    </div>
                                    <p style="margin: 0 0 0.5rem 0; font-size: 0.85rem; color: var(--secondary-color); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;"><%= item.descripcion %></p>
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: auto;">
                                        <span style="font-weight: 700; color: var(--primary-color); font-size: 1.1rem;"><%= new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', minimumFractionDigits: 0 }).format(item.precio) %></span>
                                        <span style="font-size: 0.75rem; padding: 4px 8px; background-color: <%= item.stock > 0 ? '#e8f5e9' : '#ffebee' %>; color: <%= item.stock > 0 ? '#2e7d32' : '#c62828' %>; border-radius: 20px; font-weight: 600;">
                                            Stock: <%= item.stock %>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Acciones -->
                            <div style="border-top: 1px solid var(--border-color); padding-top: 1rem; display: flex; gap: 0.5rem; justify-content: space-between; margin-top: auto;">
                                <span style="font-size: 0.75rem; color: #aaa; align-self: center;">ID: <%= item.id_producto || item.Id_producto || item.id %></span>
                                <div>
                                    <a href="/<%= modulo.toLowerCase() %>/editar/<%= item.id_producto || item.Id_producto || item.id %>" class="btn btn-sm btn-outline" style="border-radius: 6px;">✏️ Editar</a>
                                    <button class="btn btn-sm btn-danger" onclick="eliminarRegistro('<%= modulo.toLowerCase() %>', '<%= item.id_producto || item.Id_producto || item.id %>')" style="border-radius: 6px;">🗑️ Eliminar</button>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        <% }) %>
        
    <% } else if (modulo !== 'productos' && items && items.length > 0) { %>
        <!-- Vista dinámica de Tarjetas para Empleados y Clientes -->
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem; padding: 1rem 0;">
            <% items.forEach(item => { %>
                <div class="product-admin-card searchable-item animate-fade-in-up" data-search="<%= (item.nombre || item.nombre_completo || '').toLowerCase() %> <%= (item.email || '').toLowerCase() %> <%= (item.documento_identidad || '').toLowerCase() %> <%= (item.cargo || '').toLowerCase() %>" style="padding: 1.2rem; border-radius: 12px; border: 1px solid var(--border-color); background: white; box-shadow: 0 2px 8px rgba(0,0,0,0.04); transition: transform 0.2s; display: flex; flex-direction: column;">
                    <div style="display: flex; gap: 1rem; margin-bottom: 1rem;">
                        <!-- Miniatura -->
                        <div style="width: 70px; height: 70px; border-radius: 50%; overflow: hidden; background-color: #f8f9fa; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border: 1px solid #eee;">
                            <% if (modulo === 'empleados') { %>
                                <span style="font-size: 2rem; color: #dee2e6;">👔</span>
                            <% } else { %>
                                <span style="font-size: 2rem; color: #dee2e6;">👤</span>
                            <% } %>
                        </div>
                        
                        <!-- Datos Principales -->
                        <div style="flex-grow: 1; overflow: hidden;">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.25rem;">
                                <h3 style="margin: 0; font-size: 1.1rem; font-weight: 600; color: var(--text-color); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= item.nombre || item.nombre_completo %>"><%= item.nombre || item.nombre_completo %></h3>
                            </div>
                            
                            <% if (modulo === 'empleados') { %>
                                <span style="display: inline-block; padding: 4px 10px; background-color: var(--primary-color); color: white; border-radius: 20px; font-size: 0.75rem; font-weight: bold; margin-bottom: 0.5rem;"><%= item.cargo || 'Empleado' %></span>
                                <p style="margin: 0; font-size: 0.85rem; color: var(--secondary-color);">✉️ <%= item.email %></p>
                                <p style="margin: 0.2rem 0 0 0; font-size: 0.85rem; color: var(--success); font-weight: bold;">💰 <%= new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', minimumFractionDigits: 0 }).format(item.salario || 0) %></p>
                            <% } else if (modulo === 'clientes-admin') { %>
                                <span style="display: inline-block; padding: 4px 10px; background-color: #e9ecef; color: #495057; border-radius: 20px; font-size: 0.75rem; font-weight: bold; margin-bottom: 0.5rem;">C.C. <%= item.documento_identidad || 'N/A' %></span>
                                <p style="margin: 0; font-size: 0.85rem; color: var(--secondary-color);">✉️ <%= item.email %></p>
                                <p style="margin: 0; font-size: 0.85rem; color: var(--secondary-color);">📍 <%= item.direccion || 'Sin dirección' %></p>
                            <% } %>
                        </div>
                    </div>
                    
                    <!-- Acciones -->
                    <div style="border-top: 1px solid var(--border-color); padding-top: 1rem; display: flex; gap: 0.5rem; justify-content: space-between; margin-top: auto;">
                        <span style="font-size: 0.75rem; color: #aaa; align-self: center;">ID: <%= item.Id_empleado || item.Id_cliente || item.id %></span>
                        <div>
                            <a href="/<%= modulo.toLowerCase() %>/editar/<%= item.Id_empleado || item.Id_cliente || item.id %>" class="btn btn-sm btn-outline" style="border-radius: 6px;">✏️ Editar</a>
                            <button class="btn btn-sm btn-danger" onclick="eliminarRegistro('<%= modulo.toLowerCase() %>', '<%= item.Id_empleado || item.Id_cliente || item.id %>')" style="border-radius: 6px;">🗑️ Eliminar</button>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div style="grid-column: 1 / -1; text-align: center; padding: 3rem; background: white; border-radius: 12px; border: 1px dashed var(--border-color);">
            <span style="font-size: 3rem; margin-bottom: 1rem; display: block;">
                <% if (modulo === 'productos') { %>🛒<% } else { %>👥<% } %>
            </span>
            <h3>No hay registros</h3>
            <p style="color: var(--secondary-color);">Crea el primer registro usando el botón superior derecho.</p>
        </div>
    <% } %>
<% } else { %>
    <!-- Vista clásica de Tabla para los demás módulos -->
    <div class="card p-0 animate-fade-in-up delay-100" style="border: none; background: transparent; padding: 0;">
        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre / Descripción</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (items && items.length > 0) { %>
                        <% items.forEach(item => { %>
                            <% if (modulo === 'facturacion') { %>
                                <tr>
                                    <td><%= item.Id_factura %></td>
                                    <td>Cliente: <%= item.nombre_cliente || item.Id_cliente %></td>
                                    <td>
                                        <span class="badge <%= item.estado === 'Cancelado' ? 'badge-danger' : 'badge-success' %>"><%= item.estado || 'Completado' %></span>
                                    </td>
                                    <td>
                                        <h4 style="margin:0; font-weight: bold;"><%= new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', minimumFractionDigits: 0 }).format(item.total) %></h4>
                                    </td>
                                    <td>
                                        <% if(item.estado !== 'Cancelado') { %>
                                        <select class="form-select form-select-sm" onchange="cambiarEstadoPedido(<%= item.Id_factura %>, this.value)" style="padding: 4px; border-radius: 4px; border: 1px solid var(--border-color); margin-bottom: 0.5rem; display: block; width: 100%;">
                                            <option value="Pagada" <%= item.estado === 'Pagada' ? 'selected' : '' %>>Pagada</option>
                                            <option value="Preparando" <%= item.estado === 'Preparando' ? 'selected' : '' %>>Preparando</option>
                                            <option value="En Camino" <%= item.estado === 'En Camino' ? 'selected' : '' %>>En Camino</option>
                                            <option value="Entregado" <%= item.estado === 'Entregado' ? 'selected' : '' %>>Entregado</option>
                                        </select>
                                        <button class="btn btn-sm btn-danger" onclick="cancelarPedido(<%= item.Id_factura %>)" style="width: 100%;">Cancelar Pedido</button>
                                    <% } %>
                                </td>
                            </tr>
                            <% } else { %>
                                <tr>
                                    <td><%= item.Id_empleado || item.Id_cliente || item.Id_cupon || item.id %></td>
                                    <td><%= item.nombre || item.nombre_completo || item.codigo || 'Sin Nombre' %></td>
                                    <td><span class="badge badge-success">Activo</span></td>
                                    <td>
                                        <a href="/<%= modulo.toLowerCase() %>/editar/<%= item.Id_empleado || item.Id_cliente || item.Id_cupon || item.id %>" class="btn btn-sm btn-outline">Editar</a>
                                        <button class="btn btn-sm btn-danger" onclick="eliminarRegistro('<%= modulo.toLowerCase() %>', '<%= item.Id_empleado || item.Id_cliente || item.Id_cupon || item.id %>')">Eliminar</button>
                                    </td>
                                </tr>
                            <% } %>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" class="text-center p-3">No hay registros disponibles.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
<% } %>

<script>
function filtrarLista() {
    const query = document.getElementById('searchInput').value.toLowerCase();
    
    // Para vista de tarjetas (Productos, Clientes, Empleados)
    const cards = document.querySelectorAll('.searchable-item');
    if (cards.length > 0) {
        cards.forEach(card => {
            const searchData = card.getAttribute('data-search') || '';
            if (searchData.includes(query)) {
                card.style.display = 'flex';
            } else {
                card.style.display = 'none';
            }
        });
        
        // Ocultar cabeceras de categoría si no hay productos visibles (solo en Productos)
        const categories = document.querySelectorAll('h3');
        categories.forEach(header => {
            const grid = header.nextElementSibling;
            if (grid && grid.tagName === 'DIV' && grid.querySelector('.searchable-item')) {
                const cardsInGrid = grid.querySelectorAll('.searchable-item');
                let hasVisible = false;
                cardsInGrid.forEach(c => {
                    if (c.style.display !== 'none') hasVisible = true;
                });
                
                if (!hasVisible && query !== '') {
                    header.style.display = 'none';
                    grid.style.display = 'none';
                } else {
                    header.style.display = 'block';
                    grid.style.display = 'grid';
                }
            }
        });
    }

    // Para vista de tabla (Facturación, etc.)
    const tableRows = document.querySelectorAll('.table tbody tr');
    if (tableRows.length > 0 && !tableRows[0].querySelector('td[colspan]')) {
        tableRows.forEach(row => {
            const textContent = row.textContent.toLowerCase();
            if (textContent.includes(query)) {
                row.style.display = 'table-row';
            } else {
                row.style.display = 'none';
            }
        });
    }
}

async function cancelarPedido(id) {
    if(confirm('¿Estás seguro que deseas cancelar este pedido? Esta acción no se puede deshacer.')) {
        try {
            const response = await fetch(`http://localhost:3000/api/facturas/${id}/cancelar`, {
                method: 'PUT'
            });
            if(response.ok) {
                alert('Pedido cancelado correctamente');
                window.location.reload();
            } else {
                alert('Error al cancelar el pedido');
            }
        } catch(e) {
            alert('Error de red al intentar cancelar el pedido');
        }
    }
}

async function cambiarEstadoPedido(id, nuevoEstado) {
    if(confirm(`¿Estás seguro de cambiar el estado a '${nuevoEstado}'?`)) {
        try {
            const response = await fetch(`http://localhost:3000/api/facturas/${id}/estado`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ estado: nuevoEstado })
            });
            if(response.ok) {
                alert('Estado actualizado correctamente');
                window.location.reload();
            } else {
                alert('Error al actualizar el estado');
            }
        } catch(e) {
            alert('Error de red al intentar actualizar el estado');
        }
    } else {
        window.location.reload(); // Revertir el select si cancela
    }
}

async function eliminarRegistro(modulo, id) {
    if(confirm('¿Estás seguro de que deseas eliminar este registro?')) {
        try {
            let backendPath = modulo;
            if (backendPath === 'clientes-admin') backendPath = 'clientes';
            if (backendPath === 'facturacion') backendPath = 'facturas';

            const response = await fetch(`http://localhost:3000/api/${backendPath}/${id}`, {
                method: 'DELETE'
            });
            
            if(response.ok) {
                alert('Registro eliminado correctamente');
                window.location.reload();
            } else {
                alert('Error al eliminar el registro. Puede que esté siendo utilizado en otras tablas.');
            }
        } catch (e) {
            alert('Error de red al intentar eliminar el registro.');
        }
    }
}
</script>

<%- include('partials/footer') %>
